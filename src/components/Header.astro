---
import SocialLinks from './SocialLinks.astro';
import Wordmark from './Wordmark.astro';

// Kept to four so the menu fits one line on phones: Services opens at the first service, Learn at Workshops & Workbooks,
// The Journey at About.
const links = [
  { href: '#artwork', label: 'Services' },
  { href: '#workshops', label: 'Learn' },
  { href: '#about', label: 'The Journey' },
  { href: '#contact', label: 'Contact' }
];
---

<header class="bg-cream-100 text-ink">
  <div class="flex flex-col items-center gap-1.5 px-gutter py-3 sm:gap-3 sm:py-4 md:flex-row md:justify-between lg:py-5">
    {/*
      The social icons are placed three times so keyboard and screen-reader order always matches the screen: before the
      wordmark on phones, above the navigation on tablets and small laptops, and after it on wide screens. Only one copy
      is displayed at a time, and display: none takes the others out of the tab order and the accessibility tree.
      The negative right margin lines the last icon up with the page edge rather than its tap area.
    */}
    <SocialLinks background="cream" class="-mt-3 -mr-[0.8125rem] -mb-1.5 self-end md:hidden" />

    <a
      href="/"
      class="flex flex-col items-center font-serif text-[0.9375rem] leading-none tracking-[0.2em] uppercase focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-gold-500 md:text-base lg:text-lg xl:text-[1.3125rem]"
    >
      <Wordmark signatureClass="w-[6.5em] text-gold-700" />
    </a>

    <div class="md:flex md:flex-col md:items-end xl:flex-row xl:items-center xl:gap-7">
      <SocialLinks background="cream" class="-mr-[0.8125rem] max-md:hidden xl:hidden" />
      <div class="flex items-center gap-10">
        <nav aria-label="Main">
          <ul
            class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 font-sans text-[0.6875rem] font-medium tracking-[0.12em] uppercase max-[359px]:gap-x-3 max-[359px]:tracking-[0.08em] sm:gap-x-8 sm:tracking-[0.22em] lg:gap-x-10 lg:text-xs"
          >
            {
              links.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class="block py-1 hover:text-gold-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-500"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <span class="hidden h-px w-7 bg-gold-500 lg:block" aria-hidden="true"></span>
      </div>
      <SocialLinks background="cream" class="-mr-[0.8125rem] max-xl:hidden" />
    </div>
  </div>
</header>
