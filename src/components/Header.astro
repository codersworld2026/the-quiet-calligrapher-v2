---
import SocialLinks from './SocialLinks.astro';
import Wordmark from './Wordmark.astro';

// Kept to four so the menu fits one line on phones: Services opens the homepage at the first service, Learn at Workshops
// & Workbooks, The Journey at About. Every page ends with the enquiry form, so Contact stays on the page.
const links = [
  { href: '/#stationery', label: 'Services' },
  { href: '/#workshops', label: 'Learn' },
  { href: '/#about', label: 'The Journey' },
  { href: '#contact', label: 'Contact' }
];
---

<header class="bg-cream-100 text-ink">
  <div
    class="grid justify-items-center gap-1.5 px-gutter py-3 sm:gap-3 sm:py-4 md:grid-cols-[1fr_auto_1fr] md:items-center lg:py-5"
  >
    {/*
      The wordmark is centred at the top on every screen, with the menu centred beneath it. The social icons are placed
      twice so keyboard and screen-reader order always matches the screen: before the wordmark on phones, in a row of
      their own at the top right, and after it from 768px, at the right of the wordmark's row. Only one copy is displayed
      at a time, and display: none takes the other out of the tab order and the accessibility tree.
      The negative right margin lines the last icon up with the page edge rather than its tap area.
    */}
    <SocialLinks background="cream" class="-mt-3 -mr-[0.8125rem] -mb-1.5 justify-self-end md:hidden" />

    <a
      href="/"
      class="flex flex-col items-center font-serif text-[0.9375rem] leading-none tracking-[var(--tracking)] uppercase [--tracking:0.3em] max-[360px]:[--tracking:0.22em] focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-gold-500 md:col-start-2 md:text-base lg:text-lg xl:text-[1.3125rem]"
    >
      <Wordmark oneLine signatureClass="w-[6.5em] text-gold-700" />
    </a>

    <SocialLinks background="cream" class="-mr-[0.8125rem] justify-self-end max-md:hidden" />

    <nav aria-label="Main" class="md:col-span-3">
      <ul
        class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 font-sans text-[0.6875rem] font-medium tracking-[0.12em] uppercase max-[360px]:gap-x-3 max-[360px]:tracking-[0.08em] sm:gap-x-8 sm:tracking-[0.22em] lg:gap-x-10 lg:text-xs"
      >
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="block py-1 hover:text-gold-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-500"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
