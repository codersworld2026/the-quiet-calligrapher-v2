---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import GetInTouch from './GetInTouch.astro';
import { tones, type Tone } from './tones';

interface Photo {
  src: ImageMetadata;
  alt: string;
  // A Tailwind object-position class, for photos whose centre crop would cut into the lettering or the piece.
  crop?: string;
}

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  tone: Tone;
  // A pair of photos sits side by side in portrait frames, even on phones; a single photo is landscape.
  photos: [Photo] | [Photo, Photo];
}

const { id, title, subtitle, tone, photos } = Astro.props;
const colours = tones[tone];
const pair = photos.length === 2;
const hasMore = Astro.slots.has('more');
---

{/*
  Phones read straight down: the title and text, the photos, any further detail, then "Get in touch". From 1024px the
  text and photos sit side by side. The button stays under the text, unless there is further detail (the `more` slot),
  which runs the full width beneath both and is followed by the button.
*/}
<section
  id={id}
  aria-labelledby={`${id}-heading`}
  class:list={['px-gutter py-20 sm:py-24 lg:py-28', colours.section]}
>
  <div
    class:list={[
      'mx-auto grid max-w-[77rem] gap-y-10 lg:grid-cols-2 lg:items-start lg:gap-x-20',
      !hasMore && 'lg:grid-rows-[auto_1fr]'
    ]}
  >
    <div>
      <h2 id={`${id}-heading`} class="text-[2.25rem] leading-tight text-balance sm:text-5xl lg:text-[3.5rem]">
        {title}
      </h2>
      {
        subtitle && (
          <p class:list={['mt-1 text-2xl leading-snug font-medium italic sm:text-[1.75rem] lg:text-[2rem]', colours.label]}>
            {subtitle}
          </p>
        )
      }
      <span class:list={['mt-5 block h-px w-16', colours.rule]} aria-hidden="true"></span>
      <div
        class:list={[
          'mt-8 max-w-[34rem] space-y-5 text-lg leading-[1.65] font-medium text-pretty lg:text-[1.1875rem]',
          colours.body
        ]}
      >
        <slot />
      </div>
    </div>

    <div
      class:list={[
        'grid gap-3 sm:gap-4 lg:col-start-2 lg:row-start-1',
        pair && 'grid-cols-2',
        !hasMore && 'lg:row-span-2'
      ]}
    >
      {
        photos.map((photo) => (
          <Picture
            src={photo.src}
            alt={photo.alt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={pair ? [300, 450, 600, 900] : [400, 600, 800, 1200, 1600]}
            sizes={
              pair
                ? '(min-width: 1440px) 280px, (min-width: 1024px) 19vw, 42vw'
                : '(min-width: 1440px) 576px, (min-width: 1024px) 40vw, 86vw'
            }
            pictureAttributes={{ class: 'block' }}
            class:list={['w-full object-cover', pair ? 'aspect-[4/5]' : 'aspect-[4/3]', photo.crop]}
          />
        ))
      }
    </div>

    {
      hasMore && (
        <div class="lg:col-span-2">
          <slot name="more" />
        </div>
      )
    }

    <GetInTouch tone={tone} class="justify-self-start" />
  </div>
</section>
