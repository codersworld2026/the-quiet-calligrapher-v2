---
const email = 'hello@thequietcalligrapher.com';
const [user, domain] = email.split('@');

// Web3Forms emails each enquiry to the address its access key was made for. The key is meant to sit in the page (it can
// only ever send to that one address), so it lives here rather than in a secret. A new key comes from web3forms.com.
const accessKey = '1b7a8acf-d866-4758-8fd0-a19369fecabe';

// The "I am human" box is hCaptcha, under the shared site key Web3Forms gives free plans (public, like the access key).
// It only stops spam once hCaptcha is switched on for this form in the Web3Forms dashboard: then Web3Forms turns away
// every enquiry without a ticked box, including bots that post straight to it and never load this page.
const captchaSiteKey = '50b2fe65-b00b-4b9e-ad62-3ba471098be2';

// "What can I help with?" lists the services in page order, named as the sections' titles so each section's "Get in
// touch" can choose its own.
const services = [
  'Event Stationery',
  'Surface Engraving & Personalisation',
  'Bespoke Calligraphy Artwork',
  'Workshops & Workbooks',
  'Copperplate Tuition',
  'Something else'
];

const labelClass = 'block font-sans text-xs font-medium tracking-[0.2em] text-gold-700 uppercase';
// Gold-700 outlines meet the 3:1 contrast a field's edge needs on cream; 18px text stops iPhones zooming in on focus.
const fieldClass =
  'mt-2 block w-full border border-gold-700 bg-cream-100 px-4 py-3 text-lg font-medium text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-700 aria-[invalid=true]:border-rust-700';
// The message under a field that's missing or mistyped (the script below fills it in).
const errorClass = 'mt-2 text-lg leading-snug font-medium text-rust-700';
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="bg-cream-50 px-gutter py-20 text-center sm:py-24 lg:py-28"
>
  <h2 id="contact-heading" class="text-[2.25rem] leading-tight sm:text-5xl lg:text-[3.5rem]">Get in Touch</h2>
  <span class="mx-auto mt-5 block h-px w-16 bg-gold-500" aria-hidden="true"></span>

  {/*
    Without JavaScript the form posts straight to Web3Forms, which shows its own confirmation page. There's no "I am
    human" box then, so once Web3Forms requires one it turns those enquiries away and the email link is the way in.
  */}
  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    class="@container mx-auto mt-10 grid max-w-[40rem] gap-6 text-left sm:mt-12 sm:grid-cols-2"
    data-enquiry
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="New enquiry from the website" />
    <input type="hidden" name="from_name" value="The Quiet Calligrapher website" />
    {/* Web3Forms drops any enquiry with this ticked. People never see it, but spam bots fill in every box. */}
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

    <div>
      <label for="enquiry-name" class={labelClass}>Name</label>
      <input
        id="enquiry-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        aria-describedby="enquiry-name-error"
        data-missing="Please enter your name"
        class={fieldClass}
      />
      <p id="enquiry-name-error" class={errorClass} hidden></p>
    </div>
    <div>
      <label for="enquiry-email" class={labelClass}>Email</label>
      <input
        id="enquiry-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        aria-describedby="enquiry-email-error"
        data-missing="Please enter your email address"
        data-format="Please enter an email address like name@example.com"
        class={fieldClass}
      />
      <p id="enquiry-email-error" class={errorClass} hidden></p>
    </div>
    <div>
      <label for="enquiry-phone" class={labelClass}>Phone (optional)</label>
      <input id="enquiry-phone" name="phone" type="tel" autocomplete="tel" class={fieldClass} />
    </div>
    <div>
      <label for="enquiry-service" class={labelClass}>What can I help with?</label>
      <div class="relative">
        <select id="enquiry-service" name="service" class={`${fieldClass} cursor-pointer appearance-none pr-11`}>
          <option value="">Choose one (optional)</option>
          {services.map((service) => <option>{service}</option>)}
        </select>
        <svg
          class="pointer-events-none absolute top-1/2 right-4 w-3 -translate-y-1/2 text-gold-700"
          viewBox="0 0 12 7"
          fill="none"
          aria-hidden="true"
        >
          <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.25"></path>
        </svg>
      </div>
    </div>
    <div class="sm:col-span-2">
      <label for="enquiry-message" class={labelClass}>Tell me about your project</label>
      <textarea
        id="enquiry-message"
        name="message"
        rows="6"
        required
        aria-describedby="enquiry-message-error"
        data-missing="Please tell me about your project"
        class={`${fieldClass} resize-y`}></textarea>
      <p id="enquiry-message-error" class={errorClass} hidden></p>
    </div>
    {/*
      hCaptcha draws its box here (the script below loads it). The box is 303px wide, so a narrower form gets the
      compact 164 × 144 one; the space is held so the button doesn't jump down when it appears.
    */}
    <div class="sm:col-span-2">
      <div class="min-h-[78px] @max-[303px]:min-h-36" data-captcha data-sitekey={captchaSiteKey}></div>
      <p id="enquiry-captcha-error" class={errorClass} role="alert" hidden></p>
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 sm:col-span-2">
      <button
        type="submit"
        class="inline-flex h-14 cursor-pointer items-center gap-5 border border-gold-500 px-8 font-sans text-[0.8125rem] font-medium tracking-[0.3em] text-gold-700 uppercase hover:border-gold-700 hover:bg-gold-700 hover:text-cream-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-500 disabled:cursor-wait disabled:opacity-60 lg:h-[3.75rem] lg:px-10"
      >
        Send enquiry
        <svg class="w-5" viewBox="0 0 22 12" fill="none" aria-hidden="true">
          <path d="M0 6h20.5M15.5 1l5 5-5 5" stroke="currentColor" stroke-width="1.25"></path>
        </svg>
      </button>
      <p class="text-lg font-medium text-ink/80" role="status" data-enquiry-status></p>
    </div>
  </form>

  <div class="mx-auto mt-10 max-w-[40rem] focus:outline-none sm:mt-12" tabindex="-1" hidden data-enquiry-sent>
    <p class="text-2xl leading-snug font-medium sm:text-[1.75rem] lg:text-[2rem]">Thank you</p>
    <p class="mt-3 text-lg leading-[1.65] font-medium text-ink/80 lg:text-[1.1875rem]">
      Your enquiry is on its way to Aliya, and she’ll reply to the email address you gave.
    </p>
  </div>

  <p class="mt-14 font-sans text-xs font-medium tracking-[0.2em] text-gold-700 uppercase lg:mt-16">Or email Aliya</p>
  <p class="mt-3 text-2xl leading-snug font-medium sm:text-[1.75rem] lg:text-[2rem]">
    {/* <wbr> lets a narrow screen break the address after the @ instead of overflowing. */}
    <a
      href={`mailto:${email}`}
      class="underline decoration-gold-500 decoration-1 underline-offset-[0.3em] hover:text-gold-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-500"
    >
      {user}@<wbr />{domain}
    </a>
  </p>
</section>

<script>
  declare const hcaptcha: {
    render(container: HTMLElement, options: object): string;
    getResponse(widget: string): string;
    reset(widget: string): void;
  };

  // Sends the enquiry without leaving the page, then swaps the form for a thank-you note. The email's subject names the
  // service chosen, so Aliya can sort enquiries at a glance.
  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  const sent = document.querySelector<HTMLElement>('[data-enquiry-sent]');
  if (form && sent) {
    const status = form.querySelector<HTMLElement>('[data-enquiry-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const service = form.querySelector<HTMLSelectElement>('#enquiry-service')!;
    const required = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-missing]')];
    const captcha = form.querySelector<HTMLElement>('[data-captcha]')!;
    const captchaError = document.getElementById('enquiry-captcha-error')!;

    // hCaptcha loads once the form is within a screen's height, so visitors who never scroll that far don't download
    // it. Ticking the box puts its token in the form, and that's what Web3Forms checks.
    let widget: string | undefined;
    const showCaptchaError = (message: string) => {
      captchaError.textContent = message;
      captchaError.hidden = !message;
    };
    Object.assign(window, {
      enquiryCaptchaReady: () => {
        widget = hcaptcha.render(captcha, {
          sitekey: captcha.dataset.sitekey,
          size: captcha.clientWidth < 303 ? 'compact' : 'normal',
          callback: () => showCaptchaError('')
        });
      }
    });
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries[0].isIntersecting) return;
        observer.disconnect();
        const script = document.createElement('script');
        script.src = 'https://js.hcaptcha.com/1/api.js?render=explicit&onload=enquiryCaptchaReady&recaptchacompat=off';
        script.onerror = () =>
          showCaptchaError(
            'The “I am human” box didn’t load. Please refresh the page, or email hello@thequietcalligrapher.com.'
          );
        document.head.append(script);
      },
      { rootMargin: '100% 0px' }
    ).observe(form);

    // Each service section's "Get in touch" names its service, so the form arrives with it chosen. The other links to
    // the form (hero, About, header and footer) leave the choice as it is.
    document.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLElement>('[data-service]');
      if (link) service.value = link.dataset.service!;
    });

    // The form's own messages replace the browser's pop-ups, which vanish after a moment and differ between browsers.
    // Each stays under its field until it's put right. An email address needs a full domain (name@gmail isn't one),
    // or Aliya couldn't reply.
    form.noValidate = true;
    const problem = (field: HTMLInputElement | HTMLTextAreaElement) => {
      const value = field.value.trim();
      if (!value) return field.dataset.missing!;
      if (field.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) return field.dataset.format!;
      return '';
    };
    const show = (field: HTMLInputElement | HTMLTextAreaElement, message: string) => {
      const error = document.getElementById(`${field.id}-error`)!;
      error.textContent = message;
      error.hidden = !message;
      if (message) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
    };
    form.addEventListener('input', (event) => {
      const field = event.target as HTMLInputElement;
      if (field.hasAttribute('aria-invalid') && !problem(field)) show(field, '');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      let first: HTMLInputElement | HTMLTextAreaElement | undefined;
      for (const field of required) {
        const message = problem(field);
        show(field, message);
        if (message && !first) first = field;
      }
      // A message already under the box (it didn't load) is left as it is.
      const ticked = widget !== undefined && hcaptcha.getResponse(widget) !== '';
      if (!ticked && captchaError.hidden) showCaptchaError('Please tick “I am human” before sending');
      if (first) {
        first.scrollIntoView({ block: 'center' });
        first.focus({ preventScroll: true });
        return;
      }
      if (!ticked) {
        captcha.scrollIntoView({ block: 'center' });
        return;
      }

      const data = new FormData(form);
      if (service.value) data.set('subject', `New enquiry: ${service.value}`);
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const response = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message);
        form.hidden = true;
        sent.hidden = false;
        // Hiding the form shortens the page under the visitor's thumb, which can leave the note above the screen.
        sent.focus({ preventScroll: true });
        sent.scrollIntoView({ block: 'center' });
      } catch {
        // Each tick is good for one try, so the box is cleared for the next.
        hcaptcha.reset(widget!);
        status.textContent =
          'Sorry, your enquiry didn’t send. Please tick “I am human” again and resend, or email hello@thequietcalligrapher.com.';
        button.disabled = false;
        // On narrow screens the message wraps below the button, which can put it under the bottom edge.
        status.scrollIntoView({ block: 'nearest' });
      }
    });
  }
</script>
