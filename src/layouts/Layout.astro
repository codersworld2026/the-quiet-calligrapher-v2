---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import placeCardsPhoto from '../assets/images/place-cards.jpg';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { Service } from '../components/services';

interface Props {
  // A service's own page, which takes its title, description and preview photo from services.ts.
  service?: Service;
  // Any other page's title and description. The homepage leaves both out and gets the business's own.
  title?: string;
  description?: string;
}

const siteName = 'The Quiet Calligrapher';
const homeDescription =
  'Copperplate calligraphy by Aliya in Birmingham: event stationery, engraving and personalisation, bespoke artwork, workshops and 1-on-1 tuition.';

const { service } = Astro.props;
const title = service?.pageTitle ?? Astro.props.title;
const description = service?.description ?? Astro.props.description ?? homeDescription;
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} | Bespoke Calligraphy in Birmingham`;
const home = new URL('/', Astro.site).href;
const url = new URL(Astro.url.pathname, Astro.site).href;

// Link previews (WhatsApp, iMessage, Facebook and so on) show a 1200 × 630 crop of the page's photo.
const preview = async (photo: ImageMetadata, position?: string) =>
  new URL((await getImage({ src: photo, width: 1200, height: 630, fit: 'cover', position, format: 'jpg' })).src, home)
    .href;
const homePreview = await preview(placeCardsPhoto);
const pagePreview = service ? await preview(service.photo, service.photoPosition) : homePreview;

// What search engines read about the business on every page, and about the service on a service's page. Aliya works
// from a studio in Birmingham whose address isn't published, so only the city is given.
const business = {
  '@type': 'ProfessionalService',
  '@id': `${home}#business`,
  name: siteName,
  url: home,
  email: 'hello@thequietcalligrapher.com',
  description: homeDescription,
  image: homePreview,
  founder: { '@type': 'Person', name: 'Aliya' },
  address: { '@type': 'PostalAddress', addressLocality: 'Birmingham', addressCountry: 'GB' },
  areaServed: [
    { '@type': 'City', name: 'Birmingham' },
    { '@type': 'AdministrativeArea', name: 'West Midlands' }
  ],
  // The same profiles as SocialLinks.astro.
  sameAs: [
    'https://www.instagram.com/the_quiet_calligrapher/',
    'https://www.tiktok.com/@thequietcalligrapher',
    'https://www.etsy.com/uk/shop/TheQuietCalligrapher'
  ]
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    business,
    { '@type': 'WebSite', '@id': `${home}#website`, url: home, name: siteName, inLanguage: 'en-GB' },
    ...(service
      ? [
          {
            '@type': 'Service',
            name: service.title,
            description: service.description,
            url,
            provider: { '@id': business['@id'] },
            areaServed: business.areaServed
          }
        ]
      : [])
  ]
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={pagePreview} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {/*
      The tab icon is Cormorant Garamond's Q in gold on forest green. The ICO is for browsers that can't show the SVG,
      and the square PNG is for iPhone home screens, which round the corners themselves.
    */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-cormorant-garamond" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-jost" />
  </head>
  <body id="top" class="bg-cream-100 font-serif text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-cream-50 focus:px-4 focus:py-3 focus:font-sans focus:text-sm"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
